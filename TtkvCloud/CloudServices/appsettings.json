{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "click-tt": {
        "ClusterId": "click-tt",
        "Match": {
          "Path": "/click-tt/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/click-tt" },
          { "X-Forwarded": "Off" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "liga-id": {
        "ClusterId": "liga-id",
        "Match": {
          "Path": "/liga-id/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/liga-id" },
          { "X-Forwarded": "Off" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      }
    },
    "Clusters": {
      "click-tt": {
        "Destinations": {
          "primary": {
            "Address": "https://ttvn.click-tt.de/"
          }
        }
      },
      "liga-id": {
        "Destinations": {
          "primary": {
            "Address": "https://ttde-id.liga.nu/"
          }
        }
      }
    }
  }
}
