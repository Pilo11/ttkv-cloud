@page "/staffelleitung/{key:staffelkey}/{id}/eingabe"
@model TermineingabeAdminModel
@{
    ViewData["Staffelleitung"] = true;
    ViewData["Title"] = "Termineingabe – " + Model.Tenant!.Name;
    var tenant = Model.Tenant!;
    var summary = Model.Summary!;
    var listUrl = Url.Page("/Appointment/TerminGenerator", new { key = Model.Key, id = (string?)null });
}

<div class="app-termine-shell">
    <div class="app-termine-head">
        <div class="app-termine-title">
            <div>
                <nav class="app-breadcrumb" aria-label="Pfad">
                    <span class="app-eyebrow"><partial name="_Icon" model="@("lock")" /> Staffelleitung</span>
                    <span class="app-breadcrumb-sep">/</span>
                    <a href="@listUrl">Spielpläne</a>
                </nav>
                <h1>@tenant.Name</h1>
            </div>
            <div class="app-page-actions">
                <a class="app-btn" href="@Url.Page("/Appointment/TermineAdmin", "Export", new { key = Model.Key, id = Model.Id })"
                   title="Alle Termine als CSV für den Import auf der myTT-Seite">
                    <partial name="_Icon" model="@("download")" /> CSV für myTT
                </a>
                <a class="app-btn" href="@Url.Page("/Appointment/Termineingabe", new { id = Model.Id })" target="_blank" rel="noopener noreferrer">
                    Öffentliche Ansicht <partial name="_Icon" model="@("external")" />
                </a>
            </div>
        </div>
        <div class="app-termine-head-row">
            <partial name="_StaffelTabs" model="new StaffelTabs(Model.Key, Model.Id, StaffelTabs.Eingabe)" />
            <div class="app-termine-progress">
                <div class="app-progress" role="presentation"><span data-count-bar style="width: @(summary.ScheduledPercent)%"></span></div>
                <span class="app-stats">
                    <span><strong data-count-done>@summary.ScheduledCount</strong> von @summary.MatchCount terminiert</span>
                </span>
            </div>
        </div>
    </div>

    <div class="app-termine-body">
        <partial name="_Flash" model="(Model.StatusMessage, Model.ErrorMessage)" />
        <partial name="_Termineingabe" model="Model.View" />
    </div>
</div>

@section Scripts {
    <script src="~/js/termineingabe.js" asp-append-version="true"></script>
}
