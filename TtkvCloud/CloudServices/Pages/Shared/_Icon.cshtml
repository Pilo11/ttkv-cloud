        case "grid":
            <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 10h18M9 4v16" />
            break;
        case "lock":
            <rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" />
            break;
        case "upload":
            <path d="M12 16V4M7 9l5-5 5 5M5 20h14" />
