@{
    var raw = ViewContext.HttpContext.Request.Path.Value ?? "/";
    var path = raw.TrimEnd('/');
    if (path.Length == 0)
    {
        path = "/";
    }

    var isHome = string.Equals(path, "/", StringComparison.Ordinal);
    var isMyTt = string.Equals(path, "/mytt", StringComparison.OrdinalIgnoreCase);
    var isTermine = string.Equals(path, "/termine", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/termine/", StringComparison.OrdinalIgnoreCase);
}
<nav class="app-main-nav" aria-label="Hauptnavigation">
    <div class="app-nav-links">
        <a href="@Url.Page("/Home/Index")" class="app-nav-link" aria-current="@(isHome ? "page" : null)">
            <partial name="_HomeNavIcon" />
            <span class="app-nav-label">Startseite</span><span class="app-nav-label-short">Start</span>
        </a>
        <a href="@Url.Page("/MyTt/Index")" class="app-nav-link" aria-current="@(isMyTt ? "page" : null)">
            <partial name="_MyTtNavIcon" />
            <span class="app-nav-label">myTT-Verwaltung</span><span class="app-nav-label-short">myTT</span>
        </a>
        <a href="@Url.Page("/Appointment/Termine")" class="app-nav-link" aria-current="@(isTermine ? "page" : null)">
            <partial name="_TermineNavIcon" />
            <span class="app-nav-label">Terminplanung</span><span class="app-nav-label-short">Termine</span>
        </a>
    </div>
</nav>
