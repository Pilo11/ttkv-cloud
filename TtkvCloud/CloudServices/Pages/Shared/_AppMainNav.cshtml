@using CloudServices.Services.Appointment
@inject StaffelleitungAccess StaffelleitungAccess
@{
    var raw = ViewContext.HttpContext.Request.Path.Value ?? "/";
    var path = raw.TrimEnd('/');
    if (path.Length == 0)
    {
        path = "/";
    }

    var page = ViewContext.RouteData.Values["page"] as string;
    var isHome = string.Equals(path, "/", StringComparison.Ordinal);
    var isTermine = string.Equals(path, "/termine", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/termine/", StringComparison.OrdinalIgnoreCase);
    var isEingabe = page == "/Appointment/Termineingabe";
    var isStaffelleitung = page is "/Appointment/TerminGenerator" or "/Appointment/TermineAdmin" or "/Appointment/TermineingabeAdmin";
    var isMyTt = page == "/MyTt/Index";

    // The Staffelleitung and myTT links carry the secret key: only on pages already under that key.
    var key = ViewContext.RouteData.Values["key"] as string;
    var showSecret = ViewData["Staffelleitung"] is true && StaffelleitungAccess.IsValid(key);
}
<nav class="app-main-nav" aria-label="Hauptnavigation">
    <div class="app-nav-links">
        <a href="@Url.Page("/Home/Index")" class="app-nav-link" aria-current="@(isHome ? "page" : null)">
            <partial name="_HomeNavIcon" />
            <span class="app-nav-label">Startseite</span><span class="app-nav-label-short">Start</span>
        </a>
        <a href="@Url.Page("/Appointment/Termine")" class="app-nav-link" aria-current="@(isTermine ? "page" : null)">
            <partial name="_TermineNavIcon" />
            <span class="app-nav-label">Terminplanung</span><span class="app-nav-label-short">Termine</span>
        </a>
        <a href="@Url.Page("/Appointment/Termineingabe", new { id = (string?)null })" class="app-nav-link" aria-current="@(isEingabe ? "page" : null)">
            <partial name="_Icon" model="@("list-edit")" />
            <span class="app-nav-label">Termineingabe</span><span class="app-nav-label-short">Eingabe</span>
        </a>
        @if (showSecret)
        {
            <a href="@Url.Page("/Appointment/TerminGenerator", new { key, id = (string?)null })" class="app-nav-link" aria-current="@(isStaffelleitung ? "page" : null)">
                <partial name="_Icon" model="@("lock")" />
                <span class="app-nav-label">Staffelleitung</span><span class="app-nav-label-short">Staffel</span>
            </a>
            <a href="@Url.Page("/MyTt/Index", new { key })" class="app-nav-link" aria-current="@(isMyTt ? "page" : null)">
                <partial name="_MyTtNavIcon" />
                <span class="app-nav-label">myTT-Verwaltung</span><span class="app-nav-label-short">myTT</span>
            </a>
        }
    </div>
</nav>
