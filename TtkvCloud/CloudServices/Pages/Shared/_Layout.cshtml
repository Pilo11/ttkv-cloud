<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (ViewData["Staffelleitung"] is true)
    {
        @* Secret area: keep it out of search engines and Referer headers. *@
        <meta name="robots" content="noindex, nofollow" />
        <meta name="referrer" content="no-referrer" />
    }
    @{
        var title = ViewData["Title"] as string;
        var fullTitle = string.IsNullOrWhiteSpace(title) || title == "TTKV Cloud" ? "TTKV Cloud" : title + " · TTKV Cloud";
    }
    <title>@fullTitle</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <header class="app-header">
            <a class="app-brand" href="~/">
                <span class="app-brand-mark" aria-hidden="true">TT</span>
                <span>TTKV Cloud</span>
            </a>
            <partial name="_AppMainNav" />
        </header>
        <main class="app-page">
            @RenderBody()
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
